<?xml version="1.0" encoding="utf-8"?>
<!--
    Arbeitszeit-Widget (3x1)
    Nur erlaubte RemoteViews-Elemente!
    Dark Mode wird programmatisch gesetzt
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Status-Indikator (ImageView statt View!) -->
        <ImageView
            android:id="@+id/widget_status_indicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#9E9E9E"
            android:contentDescription="Status" />

        <!-- Zeit-Anzeige -->
        <TextView
            android:id="@+id/widget_duration_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0:00h"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#6750A4" />

        <!-- Chronometer (versteckt wenn nicht aktiv) -->
        <Chronometer
            android:id="@+id/widget_chronometer_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:visibility="gone" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <!-- Start Button -->
            <Button
                android:id="@+id/widget_btn_start"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:background="#4CAF50"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- Pause Button -->
            <Button
                android:id="@+id/widget_btn_pause"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="#FFC107"
                android:text="+30"
                android:textColor="#000000"
                android:textSize="10sp" />

            <!-- Stop/App Button -->
            <Button
                android:id="@+id/widget_btn_stop"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="#6750A4"
                android:text="APP"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
