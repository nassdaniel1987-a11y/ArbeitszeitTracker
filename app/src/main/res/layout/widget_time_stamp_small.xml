<?xml version="1.0" encoding="utf-8"?>
<!--
    Modernisiertes kleines Widget (2x1)
    - Rounded corners
    - Modern colors
    - Compact design
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@android:color/transparent">

    <!-- Card-Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_background_modern">

        <!-- Kompakte Zeit-Anzeige -->
        <TextView
            android:id="@+id/widget_duration_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00h"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:fontFamily="sans-serif-medium"
            android:paddingBottom="8dp" />

        <!-- Chronometer für Live-Anzeige -->
        <Chronometer
            android:id="@+id/widget_chronometer_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:fontFamily="sans-serif-medium"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <!-- Single Quick-Stempel Button -->
        <Button
            android:id="@+id/widget_quick_stamp_button"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="STEMPEL"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_primary"
            android:fontFamily="sans-serif-medium"
            android:elevation="2dp" />

    </LinearLayout>

</LinearLayout>
