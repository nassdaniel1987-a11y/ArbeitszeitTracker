<?xml version="1.0" encoding="utf-8"?>
<!--
    Modernisiertes kleines Widget (2x1)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background_modern">

    <!-- Kompakte Zeit-Anzeige -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_duration_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00h"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:fontFamily="sans-serif-medium" />

        <!-- Chronometer -->
        <Chronometer
            android:id="@+id/widget_chronometer_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Single Quick-Stempel Button -->
    <Button
        android:id="@+id/widget_quick_stamp_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="STEMPEL"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/widget_button_primary" />

</LinearLayout>
